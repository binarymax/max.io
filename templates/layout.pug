doctype html
block vars
  - var bodyclass = null;
html(lang='en')
  head
    block head
      meta(charset='utf-8')
      meta(http-equiv='X-UA-Compatible', content='IE=edge,chrome=1')
      meta(name='viewport', content='width=device-width')
      meta(name="author", content="Max Irwin")
      meta(name="canonical", content="https://maxirwin.com")
      meta(http-equiv="content-type", content="text/html;charset=UTF-8")
      meta(name="viewport", content="width=device-width,initial-scale=1.0")

      block ogtitle
        meta(name="title", property="og:title", content="maxirwin.com")
        meta(property="twitter:title", content="maxirwin.com")

      block ogimage
        meta(name="image", property="og:image", content="https://maxirwin.com/star200.png")
        meta(property="twitter:image", content="https://maxirwin.com/star200.png")      

      block ogdescription
        meta(name="description", property="og:description", ccontent="The personal blog of Max Irwin")
        meta(property="twitter:description", content="The blog of Max Irwin")

      block ogdate
        // blank

      meta(property="og:type", content="website")
      meta(property="og:url", content="https://maxirwin.com/")
      meta(property="og:site_name", content="maxirwin.com")

      meta(property="twitter:card", content="summary")
      meta(property="twitter:site:id", content="binarymax")

      link(rel="icon", type="image/png", sizes="32x32", href="/images/favicon/favicon-32x32.png")
      link(rel="icon", type="image/png", sizes="16x16", href="/images/favicon/favicon-16x16.png")
      link(rel="shortcut icon", href="/images/favicon/favicon.ico")
      link(rel="apple-touch-icon", href="/images/favicon/apple-touch-icon.png")
      link(rel="manifest", href="/images/favicon/site.webmanifest")
      link(rel="image_src", href="/images/favicon/favicon.ico")
      
      title
        block title
          = locals.name
      link(rel='alternate', href=locals.url+'/feed.xml', type='application/rss+xml', title=locals.description)
      link(rel='stylesheet', href=contents.css['main.css'].url)
      link(rel='stylesheet', href=contents.css['sonsofobsidian.css'].url)

  body(class=bodyclass)
    header.header
      div.content-wrap
        block header
          div.logo
            h1.author
              a(href="/")= locals.name
            h2= locals.description
      hr.bow.sky
      hr.bow.blue
      hr.bow.viored
      hr.bow.red
      hr.bow.yellow
    div#content
      div.content-wrap
        block content
          h2 Welcome to max.io
    footer
      div.content-wrap
        block footer
          section.about
            !=contents['about.md'].html
          section.copy
            p &copy; #{ new Date().getFullYear() } #{ locals.owner } &mdash; powered by&nbsp;
              a(href='https://github.com/jnordberg/wintersmith') Wintersmith
              //- please leave the "powered by" if you use the design
            p Please treat people the same way you want them to treat you

    script(src=locals.scripts + "site.js")

