
extends layout

block append vars
  - bodyclass = 'article-detail'

block prepend title
  | #{ page.title + " - "}

block ogtitle
  meta(name="title", property="og:title", content=page.title)
  meta(property="twitter:title", content=page.title)

block ogimage
  meta(name="image", property="og:image", content=tools.image(page.metadata.image,page.url))
  meta(property="twitter:image", content=tools.image(page.metadata.image,page.url))

block ogdescription
  meta(name="description", property="og:description", content=tools.description(page.metadata.description))
  meta(property="twitter:description", content=tools.description(page.metadata.description))

block ogdate
  meta(name="article-published_time", property="article:published_time", content=tools.published(page.metadata.date))
  meta(name="article-modified_time", property="article:modified_time", content=tools.published(page.metadata.date))
  meta(name="publish_date", property="og:publish_date", content=tools.published(page.metadata.date))

block header
  div.logo
    h1.author
        a(href="/")= locals.name
    h2= page.metadata.date
  h1= page.title

block content
  article.article
    section.content!= typogr(page.html).typogrify()

block prepend footer
  div.nav
    a(href=contents.index.url) « Full blog


