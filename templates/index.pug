extends layout

block content
  include author
  each article in articles
    // - var keys = Object.keys(article)
    // each key in keys
    //   div= key
    article.article.intro
      if article.metadata.source=='external'
        - var ico = '/images/icons/'+article.metadata.external_favicon
        header
          p.date
            span= moment.utc(article.date).format('DD. MMMM YYYY')
          h2
            a(href=article.metadata.external_url,target=_blank)
              img(src=ico,style="height:24px")
              =article.title 
        section.content
          if article.intro.length > 0
            != typogr(article.intro).typogrify()
        p.more
          a(href=article.metadata.external_url,target=_blank)
            =article.metadata.external_hostname
            img(src='/images/external-link-2.svg',style='width:12px;height:12px;margin-top:2px;margin-left:5px;display:inline-block;')
      else
        header
          p.date
            span= moment.utc(article.date).format('DD. MMMM YYYY')
          h2
            a(href=article.url)= article.title
        section.content
          if article.intro.length > 0
            != typogr(article.intro).typogrify()
          if article.hasMore
            p.more
              a(href=article.url) more

block prepend footer
  div.nav
    if prevPage
      a(href=prevPage.url) « Newer
    else
      a(href='/archive.html') « Archives
    if nextPage
      a(href=nextPage.url) Next page »



